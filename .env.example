# Reference only: RouteLab reads process environment, not .env automatically.
# PowerShell: $env:ROUTELAB_EMBEDDED_WORKER="1"
# Compose: add settings to each service's environment block.
ROUTELAB_EMBEDDED_WORKER=1
ROUTELAB_ALLOWED_HOSTS=localhost,127.0.0.1
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
# ROUTELAB_DB=/absolute/path/to/routelab.sqlite3
# Defaults: community OSRM + Photon + OpenStreetMap tiles (light personal use).
# Road coordinates and search queries go to these services. No keys required.
# Self-host all services for private/offline use. See docs/GEOGRAPHIC_ROUTING.md.
# ROUTELAB_OSRM_URL=http://127.0.0.1:5000
# ROUTELAB_OSRM_DATA_VERSION=your-extract-and-profile-version
# ROUTELAB_PHOTON_URL=http://127.0.0.1:2322
# Browser-reachable XYZ raster tiles, not a backend/container-only address:
# ROUTELAB_TILE_URL=http://127.0.0.1:8082/styles/basic-preview/{z}/{x}/{y}.png
